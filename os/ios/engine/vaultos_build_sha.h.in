// Generated by CMake from the commit CI passed in as -D VAULTOS_BUILD_SHA, or
// an empty string for a build made by hand.
//
// Only engine_fallout1.cc includes this file: the commit belongs in the one
// line that names the binary in the engine log, and nothing else changes with
// it, so nothing else is rebuilt when it changes.
#ifndef VAULTOS_BUILD_SHA
#define VAULTOS_BUILD_SHA "@VAULTOS_BUILD_SHA@"
#endif
